# --- AI ---
OPENAI_API_KEY=
AI_MODEL_PLAN=        # plan generation (vision-capable)
AI_MODEL_REVIEW=      # buildability review — strongest model
REVIEW_MODE=all       # all | load_bearing | off

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
FREE_PLANS_PER_MONTH=3
AI_MODEL_ESCALATE=   # stronger model — stages re-run when blockers remain
PLAN_COST_CAP_USD=0.60   # stop escalating beyond this per-plan spend
DAILY_SPEND_ALERT_USD=5
AI_REVIEW_TIER=          # "flex" halves review cost but is slower
AI_PLAN_TIER=priority    # Luna stages + repairs on the Fast tier; Sol stays Standard
AI_REASONING_EFFORT=medium
AI_REASONING_EFFORT_S1=  # stage-1 override (shipped: low — blueprint in ~19s)

# --- Invite-only beta ---
SITE_MODE=invite_only     # invite_only | public
ADMIN_EMAILS=             # comma-separated owner emails → /admin + always-in
BETA_MAX_PLANS_PER_DAY=10
BETA_MAX_PLANS_PER_MONTH=40

# --- Email (Resend — stubbed until set) ---
RESEND_API_KEY=
RESEND_FROM=diyest <hello@diyest.app>
OWNER_EMAIL=              # spend alerts (falls back to first ADMIN_EMAILS)

# --- Cloudflare Turnstile (waitlist) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

UNSUBSCRIBE_SECRET=       # signs unsubscribe links (falls back to service key)
